# Example Streamlit secrets configuration
# DO NOT put real API keys here - this is just a template
# 
# For Streamlit Cloud:
# 1. Deploy your app to Streamlit Cloud
# 2. Go to app settings -> Secrets
# 3. Add your real secrets there
#
# Format for secrets in Streamlit Cloud dashboard:

PINECONE_API_KEY = "your-real-pinecone-api-key"
PINECONE_ENVIRONMENT = "us-west1-gcp"
PINECONE_INDEX_NAME = "semantic-search"
LOG_LEVEL = "INFO"