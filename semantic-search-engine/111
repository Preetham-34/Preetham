"""Configuration management for Streamlit Cloud deployment - Updated."""

import os
import streamlit as st
from dotenv import load_dotenv

# Load environment variables for local development
load_dotenv()

class Config:
    """Application configuration with Streamlit Cloud secrets support."""
    
    @staticmethod
    def get_secret(key: str, default: str = None) -> str:
        """Get secret from Streamlit secrets or environment variables."""
        # Try Streamlit secrets first (for cloud deployment)
        try:
            if hasattr(st, 'secrets') and key in st.secrets:
                return st.secrets[key]
        except Exception:
            pass
        
        # Fallback to environment variables (for local development)
        return os.getenv(key, default)
    
    # Pinecone Configuration
    PINECONE_API_KEY = get_secret.__func__("PINECONE_API_KEY", "")
    PINECONE_ENVIRONMENT = get_secret.__func__("PINECONE_ENVIRONMENT", "us-west1-gcp")
    PINECONE_INDEX_NAME = get_secret.__func__("PINECONE_INDEX_NAME", "semantic-search")
    
    # Model Configuration
    EMBEDDING_MODEL = "sentence-transformers/all-MiniLM-L6-v2"
    EMBEDDING_DIMENSION = 384
    SIMILARITY_METRIC = "cosine"
    
    # Search Configuration
    DEFAULT_TOP_K = 3
    MAX_TOP_K = 10
    
    # Safety Configuration
    MAX_QUERY_LENGTH = int(get_secret.__func__("MAX_QUERY_LENGTH", "500"))
    MIN_QUERY_LENGTH = 3
    ENABLE_CONTENT_FILTER = get_secret.__func__("ENABLE_CONTENT_FILTER", "True").lower() == "true"
    BLOCKED_TERMS = ["hack", "malware", "exploit", "inject", "attack"]
    
    # UI Configuration
    APP_TITLE = "AI-Powered Semantic Search Engine"
    APP_DESCRIPTION = "Find documents by meaning using vector embeddings and neural search"
    
    # Logging
    LOG_LEVEL = get_secret.__func__("LOG_LEVEL", "INFO")
    
    @classmethod
    def validate(cls) -> bool:
        """Validate configuration."""
        if not cls.PINECONE_API_KEY:
            return False
        return True
    
    @classmethod
    def get_deployment_info(cls) -> dict:
        """Get deployment information for debugging."""
        return {
            "has_pinecone_key": bool(cls.PINECONE_API_KEY),
            "environment": cls.PINECONE_ENVIRONMENT,
            "index_name": cls.PINECONE_INDEX_NAME,
            "is_streamlit_cloud": hasattr(st, 'secrets'),
            "config_source": "streamlit_secrets" if hasattr(st, 'secrets') and "PINECONE_API_KEY" in st.secrets else "environment"
        }
